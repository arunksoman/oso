<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="oso.exe"
        Arguments=""
        InstallLocation="C:\Program Files\StackQuest\Oso">
    </Installer>
    <PackageInformation
        PackageName="Oso"
        PackageDisplayName="Oso"
        PublisherName="CN=StackQuest"
        PublisherDisplayName="StackQuest"
        Version="0.6.2.0"
        PackageDescription="Oso — Object Storage Operator">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.stackquest.oso"
                Description="Oso — Object Storage Operator"
                DisplayName="Oso"
                ExecutableName="oso.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Oso</DisplayName>
            <PublisherDisplayName>StackQuest</PublisherDisplayName>
            <Description>Oso — Object Storage Operator</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="oso.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
